# Required for /admin/login.
# Generate a new hash with and escape each "$" as "\$" before pasting:
# node -e "const bcrypt=require('bcryptjs'); bcrypt.hash('NEW_PASSWORD', 12).then(console.log)"
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# Optional: additional token access for /api/images upload/delete mutations.
ADMIN_UPLOAD_TOKEN=

# Required for /api/images. Provisioned automatically when a Vercel Blob store
# is linked to the project (`vercel blob create-store <name> --access public`).
BLOB_READ_WRITE_TOKEN=

# Required for /api/contact to actually send emails. Provisioned automatically
# by the Resend Marketplace integration (`vercel integration add resend/resend-email`).
# RESEND_EMAIL_DOMAIN must be a domain verified in Resend.
RESEND_API_KEY=
RESEND_EMAIL_DOMAIN=
