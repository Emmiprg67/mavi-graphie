# Required for /admin/login.
# Generate a new hash with and escape each "$" as "\$" before pasting:
# node -e "const bcrypt=require('bcryptjs'); bcrypt.hash('NEW_PASSWORD', 12).then(console.log)"
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# Optional: additional token access for /api/images upload/delete mutations.
ADMIN_UPLOAD_TOKEN=

# Required for /api/images. Holds the JSON manifest (which images exist, their
# category/order/alt text) on Vercel Blob. Provisioned automatically when a
# Blob store is linked to the project (`vercel blob create-store <name> --access public`).
BLOB_READ_WRITE_TOKEN=

# Required for /api/images. Stores and delivers the actual uploaded image files
# via Cloudinary. Find these in the Cloudinary Dashboard at
# https://console.cloudinary.com/ (top of the page, under "Product Environment
# Credentials" / API Keys). Not a Vercel Marketplace integration — add manually
# via `vercel env add` or the Vercel dashboard.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Required for /api/contact to actually send emails. Provisioned automatically
# by the Resend Marketplace integration (`vercel integration add resend/resend-email`).
# RESEND_EMAIL_DOMAIN must be a domain verified in Resend.
RESEND_API_KEY=
RESEND_EMAIL_DOMAIN=
